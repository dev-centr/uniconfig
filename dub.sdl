name "uniconfig"
description "UniConfig Config Panel — schema-driven desktop editor for config files"
version "0.1.0"
authors "DevCentr"
copyright "Copyright © 2026, DevCentr"
homepage "https://github.com/dev-centr/uniconfig"
license "MIT"

targetType "executable"
targetName "uniconfig"
sourcePaths "source"
importPaths "source"
copyFiles "profiles"
mainSourceFile "source/app.d"

dependency "uniconfig-core" path="../uniconfig-core"
dependency "dlangui" repository="git+https://github.com/dlang-supplemental/dlangui.git" version="457ffb3c856bedba5fdcf481fc0d787e4c9c1da3"

configuration "application" {
	targetType "executable"
	mainSourceFile "source/app.d"
}

