{
  "$schema": "https://docs.devcentr.org/themed-svg/schemas/themed-svg-manifest-v1.schema.json",
  "schemaVersion": 1,
  "namespace": "uniconfig-layers",
  "source": {
    "kind": "diagram-generator",
    "uri": "layers.mmd",
    "generator": "mermaid"
  },
  "tokens": [
    { "id": "color.canvas", "description": "Diagram canvas" },
    { "id": "color.surface.panel", "description": "Configuration panel surface" },
    { "id": "color.surface.meaning", "description": "Semantic vocabulary layer" },
    { "id": "color.surface.storage", "description": "Storage format layer" },
    { "id": "color.text.primary", "description": "Text on light surfaces" },
    { "id": "color.text.inverse", "description": "Text on dark surfaces" },
    { "id": "color.border.primary", "description": "Panel border" },
    { "id": "color.edge", "description": "Layer relationship edge" }
  ],
  "defaultPreset": "light",
  "presets": {
    "light": {
      "color.canvas": "#f4f1eb",
      "color.surface.panel": "#ece8e1",
      "color.surface.meaning": "#2c4f4b",
      "color.surface.storage": "#1c1c1e",
      "color.text.primary": "#1c1c1e",
      "color.text.inverse": "#ece8e1",
      "color.border.primary": "#1c1c1e",
      "color.edge": "#4b7f7a"
    },
    "dark": {
      "color.canvas": "#111315",
      "color.surface.panel": "#292b2e",
      "color.surface.meaning": "#315d57",
      "color.surface.storage": "#08090a",
      "color.text.primary": "#f2eee7",
      "color.text.inverse": "#f2eee7",
      "color.border.primary": "#c8c3bb",
      "color.edge": "#78aaa4"
    }
  },
  "bindings": [
    { "kind": "presentation", "selector": "svg", "attribute": "color", "token": "color.text.primary" },
    { "kind": "presentation", "selector": ".background", "attribute": "fill", "token": "color.canvas" },
    { "kind": "stylesheet", "selector": "#my-svg .panel rect", "property": "fill", "token": "color.surface.panel" },
    { "kind": "stylesheet", "selector": "#my-svg .meaning rect", "property": "fill", "token": "color.surface.meaning" },
    { "kind": "stylesheet", "selector": "#my-svg .storage rect", "property": "fill", "token": "color.surface.storage" },
    { "kind": "stylesheet", "selector": "#my-svg .panel tspan", "property": "fill", "token": "color.text.primary" },
    { "kind": "stylesheet", "selector": "#my-svg .meaning tspan", "property": "fill", "token": "color.text.inverse" },
    { "kind": "stylesheet", "selector": "#my-svg .storage tspan", "property": "fill", "token": "color.text.inverse" },
    { "kind": "stylesheet", "selector": "#my-svg .panel rect", "property": "stroke", "token": "color.border.primary" },
    { "kind": "stylesheet", "selector": "#my-svg .flowchart-link", "property": "stroke", "token": "color.edge" }
  ],
  "fallback": {
    "unresolvedToken": "error",
    "missingTarget": "warn"
  }
}
