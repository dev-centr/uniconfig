{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "DUB recipe",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "title": "Name", "description": "Package name on the DUB registry" },
    "description": { "type": "string", "title": "Description" },
    "authors": { "type": "string", "title": "Authors" },
    "license": {
      "type": "string",
      "title": "License",
      "enum": ["MIT", "BSL-1.0", "Apache-2.0", "GPL-3.0", "LGPL-3.0", "public domain"]
    },
    "targetType": {
      "type": "string",
      "title": "Target type",
      "enum": ["executable", "library", "sourceLibrary", "staticLibrary", "dynamicLibrary"]
    },
    "homepage": { "type": "string", "title": "Homepage" }
  }
}
