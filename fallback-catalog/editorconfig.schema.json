{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "EditorConfig",
  "type": "object",
  "properties": {
    "*": {
      "type": "object",
      "title": "All files",
      "properties": {
        "charset": { "type": "string", "enum": ["utf-8", "utf-8-bom", "latin1", "utf-16be", "utf-16le"] },
        "end_of_line": { "type": "string", "enum": ["lf", "cr", "crlf"] },
        "insert_final_newline": { "type": "boolean" },
        "indent_style": { "type": "string", "enum": ["tab", "space"] },
        "indent_size": { "type": "integer" }
      }
    }
  }
}
